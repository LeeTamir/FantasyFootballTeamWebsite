# ─────────────────────────────────────────────────────────────
# ESPN Fantasy backend configuration
# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored and never shipped to the browser.
# ─────────────────────────────────────────────────────────────

# Your league ID — the number in the ESPN league URL:
# https://fantasy.espn.com/football/league?leagueId=123456  ->  123456
LEAGUE_ID=123456

# Season year (the current fantasy season)
YEAR=2026

# ── Private-league credentials ──
# Log in at fantasy.espn.com, open your browser DevTools → Application/Storage
# → Cookies → https://fantasy.espn.com, and copy these two cookie values.
# Leave both blank if your league is PUBLIC.
ESPN_S2=
SWID=

# Which team is yours. Easiest: start the server, open
# http://localhost:8000/api/teams to see every team's id + name,
# then paste your team's id here. (Falls back to TEAM_NAME match if blank.)
TEAM_ID=
TEAM_NAME=Lee's Team

# Approximate date of NFL Week 1 (used to label upcoming matchups).
# 2026 regular season opens Thursday Sep 10, 2026.
NFL_WEEK1_DATE=2026-09-10

# How many roster players to pull news for, and cache lifetime (seconds).
NEWS_PLAYER_LIMIT=16
CACHE_TTL_SECONDS=300

# Comma-separated origins allowed to call this API (your frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
